# ===== FDI Invoice & Tax Automation Pro – biến môi trường =====
# Chuỗi kết nối PostgreSQL (bắt buộc)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/fdi_dev"

# Đặt "true" khi chạy sau HTTPS để cookie có cờ Secure
COOKIE_SECURE="false"

# Lưu trữ file XML/PDF riêng tư: "local" (ổ đĩa máy chủ) hoặc "s3" (S3/R2/MinIO)
STORAGE_DRIVER="local"
STORAGE_LOCAL_DIR="./storage-data"

# Chỉ dùng khi STORAGE_DRIVER="s3"
S3_BUCKET=""
S3_REGION="auto"
S3_ENDPOINT=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""

# Xử lý nền: "inline" = chạy trong tiến trình web; "worker" = chỉ chạy bằng `npm run worker`
JOB_MODE="inline"

# Tài khoản quản trị hệ thống được tạo khi chạy seed lần đầu
SEED_ADMIN_EMAIL="admin@fdi.local"
SEED_ADMIN_PASSWORD="Admin@12345"
